# Copy to core_backend/.env and fill in real values. Never commit the copy.

# Required
DATABASE_URL=postgresql://user:password@localhost:5432/secure_flow
# JWT signing key: at least 32 random characters. The server refuses to start without one.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Environment: development | production. Production disables the mock data sources by default.
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# Host names this API answers to (Host header allowlist)
ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to call the API (the separately hosted frontend)
CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1)(:\d+)?$

# RESO Web API (defaults to the bundled mock server at /api/mock-reso/odata)
RESO_API_BASE_URL=http://127.0.0.1:8000/api/mock-reso/odata
RESO_API_TOKEN=mock-reso-token
# Mount the mock RESO server (default: on unless APP_ENV=production)
ENABLE_MOCK_SOURCES=true

# Enclave capacity: concurrent sandbox workers overall and per user
ENCLAVE_MAX_CONCURRENT=4
ENCLAVE_MAX_PER_USER=2
