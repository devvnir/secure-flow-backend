# Copy to core_backend/.env and fill in real values. Never commit the copy.

# Required
DATABASE_URL=postgresql://user:password@localhost:5432/secure_flow
# JWT signing key: at least 32 random characters. The server refuses to start without one.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Environment: development | production. Production disables the mock data sources by default.
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# Host names this API answers to (Host header allowlist)
ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to call the API (the separately hosted frontend)
CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1)(:\d+)?$

# RESO Web API (defaults to the bundled mock server at /api/mock-reso/odata)
RESO_API_BASE_URL=http://127.0.0.1:8000/api/mock-reso/odata
RESO_API_TOKEN=mock-reso-token
# Mount the mock RESO server (default: on unless APP_ENV=production)
ENABLE_MOCK_SOURCES=true

# Enclave capacity: concurrent sandbox workers overall and per user
ENCLAVE_MAX_CONCURRENT=4
ENCLAVE_MAX_PER_USER=2

# Reverse proxies whose X-Forwarded-For is trusted for the client IP (signatures, audit, rate limits).
# Comma-separated peer IPs or CIDR ranges, e.g. 10.0.0.5 or 10.0.0.0/8 (Render). Leave empty when clients
# connect directly.
# If you start the server with the uvicorn CLI, pass --no-proxy-headers so only this list applies.
TRUSTED_PROXY_IPS=

# Stripe (Milestone 4) - test-mode keys from https://dashboard.stripe.com/test/apikeys
# sk_live_ keys are refused unless APP_ENV=production.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (Dashboard > Webhooks, or `stripe listen` output)
STRIPE_WEBHOOK_SECRET=
# Subscription tiers are defined in Stripe, not here: every active recurring Price whose price or
# product metadata has tier_id is offered (create them with: python tools/stripe_setup.py).
# The tier catalog is re-synced from Stripe at most this often, and kept current by webhooks.
STRIPE_CATALOG_TTL_SECONDS=600
# Webhook events to enable on the endpoint: checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# customer.subscription.*, invoice.paid, invoice.payment_failed, price.*, product.*
# Payment is chosen once at checkout: US bank account (ACH, no fee) or card (+ this fee, billed as
# its own invoice line). Card networks cap surcharges at 3% (Visa) and forbid them on debit and
# prepaid cards; the server logs a warning above 3%. Enable "ACH Direct Debit" in Stripe settings.
CARD_FEE_PERCENT=5
# Where Stripe Checkout and the billing portal send the user back to
FRONTEND_URL=http://localhost:3000
